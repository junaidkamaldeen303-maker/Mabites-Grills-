# 1. First, create .gitignore file
cat > .gitignore << 'EOF'
# Node modules
node_modules/

# Environment variables
.env
.env.local
.env.production
.env.development

# Uploaded files
uploads/
uploads/*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PM2
.pm2/
pm2-*.log

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE files
.vscode/
.idea/
*.iml

# Backup files
*.backup
*.bak
*.old

# Temp files
*.tmp
*.temp
*.cache

# Build output
dist/
build/
.next/
out/

# Testing
coverage/
.nyc_output/

# MongoDB
data/
dump/

# Environment
.env.*
!.env.example
EOF

# 2. Remove node_modules from git cache (if already added)
git rm -r --cached node_modules

# 3. Add .gitignore
git add .gitignore

# 4. Commit the .gitignore
git commit -m "Add .gitignore to exclude node_modules and other unnecessary files"

# 5. Now add all other files (excluding node_modules)
git add .

# 6. Commit again
git commit -m "Mabites Grills MVP - Production Ready"

# 7. Rename branch to main
git branch -M main

# 8. Add remote (replace with your GitHub URL)
git remote add origin https://github.com/yourusername/mabites-grills.git

# 9. Push to GitHub
git push -u origin main